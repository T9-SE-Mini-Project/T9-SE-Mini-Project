# Copy to .env for local development. Never commit the real .env.

# SQLAlchemy URL. PostgreSQL in production, e.g.
#   postgresql+psycopg://bbms:password@localhost:5432/bbms
DATABASE_URL=sqlite:///./bbms.db

# Create missing tables at startup (local development). Set to false once Alembic owns the schema.
BBMS_CREATE_TABLES=true

# Log a user out after this many seconds without activity (BBS-SR-005).
SESSION_IDLE_TIMEOUT_SECONDS=900

# Comma-separated browser origins allowed to call the API (React + Vite dev server).
CORS_ORIGINS=http://localhost:5173

# Hospital requests: maximum units in one request (BLOOD-15).
MAX_UNITS_PER_REQUEST=10

# Drive reminders go to donors whose slot starts within this many hours (BBS-F-042).
REMINDER_WINDOW_HOURS=24
